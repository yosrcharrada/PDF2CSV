# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Project runtime output (never commit client data) ---
# The ISIN ledger records which of the client's real, finite codes have
# been consumed. It is live operational state, not source: committing it
# would publish the allocation register and, worse, let a checkout
# overwrite the real one and reissue codes already in circulation.
isin_ledger.json
*.isin_ledger.json
# The ISIN workbook holds a client's real, finite, reserved codes.
# Drop it in isin/ and it is found automatically; it is never committed.
# The obviously-fake sample-pool.xlsx is committed so a fresh clone runs.
/logs/
/output/
/.cache/
/work/
/uploads/
*.validation.json

# --- Portable bundle build artefacts (large, rebuildable) ---
/build_portable/
/wheels/
/models/*
!/models/README.md
!/models/.gitkeep
/vendor/

# --- Notebooks ---
.ipynb_checkpoints/
notebooks/*.ipynb
!notebooks/template.ipynb

# --- Client PDFs: opt in explicitly, never by accident ---
# Only the fixtures make_fixtures.py generates are whitelisted, by name. A
# blanket "!tests/fixtures/pdfs/*.pdf" would sweep in any document that happens
# to land in that folder — a cloud-sync drop, a file copied in for a quick
# check — and committing a client statement is not a mistake you can undo.
*.pdf
!tests/fixtures/pdfs/statement_ruled_2page.pdf
!tests/fixtures/pdfs/statement_borderless_fr.pdf
!tests/fixtures/pdfs/statement_broken.pdf
!tests/fixtures/pdfs/statement_scanned.pdf
!tests/fixtures/pdfs/letter_no_table.pdf
!tests/fixtures/pdfs/multi_table.pdf
*.xlsx
!tests/fixtures/expected/*.xlsx

# --- OS / editor / local tooling ---
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
.claude/

# --- ISIN workbook -----------------------------------------------------------
# A client's real workbook holds finite, reserved codes and is never committed;
# the blanket *.xlsx rule above already covers it. Drop it in isin/ and it is
# found automatically. This exception has to come last: git applies the final
# matching rule, so placing it before *.xlsx would have no effect.
!/isin/sample-pool.xlsx
